DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use local SQLite, or configure PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/tours
# DB_SSLMODE=prefer

# Docker Compose PostgreSQL defaults. Change the password for shared environments.
POSTGRES_DB=tours
POSTGRES_USER=tours
POSTGRES_PASSWORD=tours_dev_password

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true
LIQPAY_SERVER_URL=https://your-api.example.com/cabinet/api/liqpay-callback/
LIQPAY_RESULT_URL=http://localhost:5173/cabinet/booking
